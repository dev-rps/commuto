# Frontend Environment Variables
# Copy this file to .env and fill in the values

# The URL of your backend API (no trailing slash)
# Local development:
VITE_API_URL=http://localhost:4000/api

# Production (Render): uncomment and set your actual Render URL
# VITE_API_URL=https://your-render-app-name.onrender.com/api

# Set to 'true' to use mock data instead of hitting the real backend.
# Leave as 'false' (or omit) for production and staging.
VITE_USE_MOCKS=false
